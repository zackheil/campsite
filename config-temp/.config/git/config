[user]
	name = Zack Heil
	email = 99351543+zack-heil-fhr@users.noreply.github.com
	signingkey = ~/.local/share/git/work-git-commit-sign-key.pub

[core]
	sshCommand = "ssh -F ~/.local/share/git/auth-work-ssh-config"

[gpg "ssh"]
	allowedSignersFile = ~/.local/share/git/work-git-sign-key-allowed-signers

[init]
	defaultBranch = main

[core]
	editor = code --wait
	autocrlf = input

[http]
	postBuffer = 157286400

[gpg]
	format = ssh

[url "ssh://git@ssh.github.com/"]
    insteadOf = https://github.com/
    insteadOf = http://github.com/

[url "ssh://git@kochsource.io/"]
    insteadOf = https://kochsource.io/
    insteadOf = http://kochsource.io/

[commit]
	gpgSign = true 

[includeIf "gitdir:~/Developer/personal/"]
	path = ~/.config/git/config-personal

